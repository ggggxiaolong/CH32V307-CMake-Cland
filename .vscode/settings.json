{
  "cortex-debug.openocdPath": "${userHome}/Documents/ch32_toolchain/OpenOCD/OpenOCD/bin/openocd",
  "cortex-debug.gdbPath": "${userHome}/Documents/ch32_toolchain/riscv_gcc12/bin/riscv-wch-elf-gdb",
  "search.exclude": {
    "**/build": true
  },
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": [
    "--query-driver=/home/MrTan/Documents/ch32_toolchain/riscv_gcc12/bin/riscv-wch-elf*"
  ],
  "clangd.formatOnType": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  }
}
