    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex-Debug",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/build/ch32v307-ninja.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "external",
            "gdbTarget": ":3333",
            "gdbPath": "${userHome}/Documents/ch32_toolchain/riscv_gcc/bin/riscv-none-embed-gdb",
            "svdPath": "${workspaceFolder}/CH32V307xx.svd",
            "preLaunchTask": "run_openocd",
            "runToEntryPoint": "main",
        }

    ]
}
